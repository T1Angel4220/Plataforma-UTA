# ========================================================
# Configuración del Entorno - Plataforma Educativa UTA
# Copie este archivo como .env y complete sus valores locales
# ========================================================

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=plataforma_educativa

# Google OAuth 2.0 Credentials
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/Plataforma-UTA/callback_google.php

# Microsoft 365 / Azure AD Credentials
# Obtener en: https://portal.azure.com/#blade/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
MS_TENANT_ID=common
MS_CLIENT_ID=tu_microsoft_client_id
MS_CLIENT_SECRET=tu_microsoft_client_secret
MS_REDIRECT_URI=http://localhost/Plataforma-UTA/callback.php

